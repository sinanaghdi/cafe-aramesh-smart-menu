# Development defaults only. Never use these credentials in production.
ENVIRONMENT=development
POSTGRES_DB=aramesh
POSTGRES_USER=aramesh
POSTGRES_PASSWORD=aramesh-local-only
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=8080
# For Docker Compose the database hostname is "db". Use localhost only when running
# the API directly on the host rather than inside Compose.
DATABASE_URL=postgresql+psycopg://aramesh:aramesh-local-only@db:5432/aramesh
AI_PROVIDER=none
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=8.0
FEATURE_ONLINE_ORDERING_ENABLED=false
FEATURE_AI_AGENT_ENABLED=false
FEATURE_AI_SUPPORT_ENABLED=false
JWT_SECRET_KEY=dev-jwt-secret-change-before-production
ORDER_CODE_HMAC_SECRET=dev-order-code-secret-change-before-production
ORDER_CODE_DIGITS=4
ORDER_CODE_TTL_MINUTES=15
ORDER_CODE_MAX_ATTEMPTS=5
COOKIE_SECURE=false
# Demo credentials are for local development only; override them outside local development.
DEMO_STAFF_EMAIL=staff@aramesh.local
DEMO_STAFF_PASSWORD=StaffDemo!2026
DEMO_MERCHANT_EMAIL=merchant@aramesh.local
DEMO_MERCHANT_PASSWORD=MerchantDemo!2026
